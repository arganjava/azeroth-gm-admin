{
  "name": "azerothcore-rest-api",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for AzerothCore account and realm management",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:web": "node src/web.js",
    "start:prod": "pm2 startOrReload ecosystem.config.js --env production",
    "deploy:prod": "npm ci && npm run build && npm run start:prod",
    "dev": "node --watch src/server.js",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "check": "node --check src/server.js && node --check src/soap.js && node --check src/srp6.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "mysql2": "^3.12.0",
    "pm2": "^7.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "soap": "^1.13.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.3.5"
  }
}
